# local = sunucusuz demo (veri tarayıcıda) · server = Node sunucusu (npm run sunucu)
VITE_API_MODE=local

# Ana Admin hesabı (yalnızca ilk kurulumda, veritabanı boşken kullanılır)
VITE_SEED_ADMIN_EMAIL=info@batilmer.com
VITE_SEED_ADMIN_PASSWORD=BURAYA_ILK_SIFRE

# Formların yayınlanacağı adres. Boş bırakılırsa çalıştığı adres kullanılır (localhost'ta http://localhost:5180)
# Canlıda: https://form.batilmer.com
VITE_FORM_BASE_URL=

# Demo modunda Turnstile denemek için (canlıda sunucu.env içindeki TURNSTILE_SITE_KEY kullanılır)
VITE_TURNSTILE_SITE_KEY=
